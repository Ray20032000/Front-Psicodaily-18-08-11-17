# Desenvolvimento: o navegador usa /api e /ws no mesmo host do frontend.
VITE_API_PROXY_TARGET=https://127.0.0.1:5000

# Opcional para API hospedada separadamente. Configure CALL_ALLOWED_ORIGINS no backend.
# VITE_API_URL=https://api.exemplo.com/api
# VITE_SIGNALING_URL=wss://api.exemplo.com/ws/signaling

# Northflank: variável de RUNTIME do container Nginx, não de build.
# Serviço da API no mesmo projeto, porta 8000 privada. Sem barra final.
API_UPSTREAM=http://psicodaily-api:8000
# Frontend: Dockerfile=/Dockerfile, contexto=/, porta HTTP pública 8080.
# Health check HTTP: /healthz, porta 8080. HTTPS é gerenciado pelo Northflank.
